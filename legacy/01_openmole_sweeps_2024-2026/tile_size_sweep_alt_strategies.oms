// ─── Sweep: tile size vs strategy (EgocentricIR / ConnectivityInteraction / SR) ──
// Goal: compare EgocentricInteractionRichness and ConnectivityInteraction against the
// SpeciesRichness baseline across tile sizes.
//
// EgocentricIR counts all interactions where at least one endpoint is in the tile
// (vs intra-tile IR which requires both endpoints to be co-located).
// ConnectivityInteraction blends connectivity and interaction richness 50/50.
//
// Fixed parameters (identical to tile_size_sweep.oms for comparability):
//   preyPerPredator                  = 0.5
//   extinctionProbabilityUnprotected = 0.25
//   observationNoise / falsePositiveRate = 0.0
//   nAdminRegions = 1
// Swept parameters:
//   fractionProtected     in 0.0 to 1.0 by 0.025
//   avgPopulationsPerTile in Seq(2, 5, 10, 20, 40, 80, 160)

// ─── Inputs ───────────────────────────────────────────────────────────────────
val fractionProtected     = Val[Double]
val avgPopulationsPerTile = Val[Int]
val myseed                = Val[Int]

// ─── Shared landscape diagnostics ────────────────────────────────────────────
val nTiles              = Val[Int]
val landscapeAlphaSR    = Val[Double]
val landscapeAlphaIR    = Val[Double]
val landscapeAlphaSRstd = Val[Double]
val landscapeAlphaIRstd = Val[Double]
val landscapeBetaSR     = Val[Double]
val landscapeBetaIR     = Val[Double]

// ─── Per-strategy outputs ─────────────────────────────────────────────────────
// Extinction fractions (%)
val speciesExtinctions_species      = Val[Double]
val speciesExtinctions_egoIR        = Val[Double]
val speciesExtinctions_connInt      = Val[Double]
val interactionExtinctions_species  = Val[Double]
val interactionExtinctions_egoIR    = Val[Double]
val interactionExtinctions_connInt  = Val[Double]

// Cascade counts
val nCascades_species  = Val[Int]
val nCascades_egoIR    = Val[Int]
val nCascades_connInt  = Val[Int]

// Primary extinctions (absolute counts)
val primarySpeciesExtinctions_species         = Val[Int]
val primarySpeciesExtinctions_egoIR           = Val[Int]
val primarySpeciesExtinctions_connInt         = Val[Int]
val primaryInteractionExtinctions_species     = Val[Int]
val primaryInteractionExtinctions_egoIR       = Val[Int]
val primaryInteractionExtinctions_connInt     = Val[Int]

// Secondary extinctions (absolute counts)
val secondarySpeciesExtinctions_species       = Val[Int]
val secondarySpeciesExtinctions_egoIR         = Val[Int]
val secondarySpeciesExtinctions_connInt       = Val[Int]
val secondaryInteractionExtinctions_species   = Val[Int]
val secondaryInteractionExtinctions_egoIR     = Val[Int]
val secondaryInteractionExtinctions_connInt   = Val[Int]

// Beta diversity of protected set (pre-extinction)
val speciesBetaDiversity_pre_species          = Val[Double]
val speciesBetaDiversity_pre_egoIR            = Val[Double]
val speciesBetaDiversity_pre_connInt          = Val[Double]
val interactionBetaDiversity_pre_species      = Val[Double]
val interactionBetaDiversity_pre_egoIR        = Val[Double]
val interactionBetaDiversity_pre_connInt      = Val[Double]

// ─── ScalaTask ────────────────────────────────────────────────────────────────
val altStrategySweepSim = ScalaTask(
  """
  import econetcons._

  val worldParameters = WorldParameters(
    numberOfSpecies                  = 200,
    connectanceMetaWeb               = 0.4,
    areaOverlap                      = 20.0,
    medianHomeRange                  = 0.05,
    avgPopulationsPerTile            = avgPopulationsPerTile,
    useThinning                      = false,
    spreadingFactor                  = 0.5,
    useHotspot                       = false,
    extinctionProbabilityUnprotected = 0.25,
    preyPerPredator                  = 0.5,
    observationNoise                 = 0.0,
    falsePositiveRate                = 0.0
  )

  // ── Tile count (derived, for output) ────────────────────────────────────────
  val nTiles = {
    val numberOfPopulations = (worldParameters.areaOverlap / (worldParameters.medianHomeRange * worldParameters.medianHomeRange)).toInt
    val side = math.ceil(math.sqrt(numberOfPopulations.toDouble / worldParameters.avgPopulationsPerTile.toDouble)).toInt
    side * side
  }

  // ── Base world: no protection applied ───────────────────────────────────────
  val baseConservationParameters = ConservationParameters(
    fractionProtected = 0.0,
    strategy          = Some(ConservationStrategy.SpeciesRichness),
    nAdminRegions     = 1
  )
  val baseWorld = World(
    worldParameters        = worldParameters,
    conservationParameters = baseConservationParameters,
    rnd                    = Random(myseed)
  )

  // ── Landscape diagnostics (base world, before any protection) ───────────────
  val baselineMetrics   = DiagnosticMetrics.computeBaseline(baseWorld)
  val landscapeAlphaSR  = baselineMetrics.spAlphaMean
  val landscapeAlphaIR  = baselineMetrics.intAlphaMean
  val landscapeAlphaSRstd = baselineMetrics.spAlphaStd
  val landscapeAlphaIRstd = baselineMetrics.intAlphaStd
  val landscapeBetaSR   = baselineMetrics.spBeta
  val landscapeBetaIR   = baselineMetrics.intBeta

  // ── Conservation parameter sets ──────────────────────────────────────────────
  val spParams = ConservationParameters(
    fractionProtected = fractionProtected,
    strategy          = Some(ConservationStrategy.SpeciesRichness),
    nAdminRegions     = 1
  )
  val egoIRParams = ConservationParameters(
    fractionProtected = fractionProtected,
    strategy          = Some(ConservationStrategy.EgocentricInteractionRichness),
    nAdminRegions     = 1
  )
  val connIntParams = ConservationParameters(
    fractionProtected = fractionProtected,
    strategy          = Some(ConservationStrategy.ConnectivityInteraction),
    nAdminRegions     = 1
  )

  val worldWithSpStrategy = baseWorld.copy(
    managementLandscape    = baseWorld.managementLandscape.applyProtectionPlan(spParams, Random(myseed)),
    conservationParameters = spParams
  ).deepCopyForExtinction(Random(myseed))

  val worldWithEgoIRStrategy = baseWorld.copy(
    managementLandscape    = baseWorld.managementLandscape.applyProtectionPlan(egoIRParams, Random(myseed)),
    conservationParameters = egoIRParams
  ).deepCopyForExtinction(Random(myseed))

  val worldWithConnIntStrategy = baseWorld.copy(
    managementLandscape    = baseWorld.managementLandscape.applyProtectionPlan(connIntParams, Random(myseed)),
    conservationParameters = connIntParams
  ).deepCopyForExtinction(Random(myseed))

  // ── Pre-extinction beta diversity ─────────────────────────────────────────────
  val (spBeta_pre_species,  intBeta_pre_species)  = DiagnosticMetrics.computeProtectedBetaDiversity(worldWithSpStrategy)
  val (spBeta_pre_egoIR,    intBeta_pre_egoIR)    = DiagnosticMetrics.computeProtectedBetaDiversity(worldWithEgoIRStrategy)
  val (spBeta_pre_connInt,  intBeta_pre_connInt)  = DiagnosticMetrics.computeProtectedBetaDiversity(worldWithConnIntStrategy)

  val speciesBetaDiversity_pre_species      = spBeta_pre_species
  val speciesBetaDiversity_pre_egoIR        = spBeta_pre_egoIR
  val speciesBetaDiversity_pre_connInt      = spBeta_pre_connInt
  val interactionBetaDiversity_pre_species  = intBeta_pre_species
  val interactionBetaDiversity_pre_egoIR    = intBeta_pre_egoIR
  val interactionBetaDiversity_pre_connInt  = intBeta_pre_connInt

  // ── Run extinctions ──────────────────────────────────────────────────────────
  val resultSp      = worldWithSpStrategy.extinctionsDetailed()
  val resultEgoIR   = worldWithEgoIRStrategy.extinctionsDetailed()
  val resultConnInt = worldWithConnIntStrategy.extinctionsDetailed()

  val finalWorldSp      = resultSp.finalWorld
  val finalWorldEgoIR   = resultEgoIR.finalWorld
  val finalWorldConnInt = resultConnInt.finalWorld

  // ── Extinction fractions ──────────────────────────────────────────────────────
  // initialInteractionsRichness captured inside extinctionsDetailed() before graph mutation.
  val initialSR_sp      = resultSp.initialSpeciesRichness
  val initialIR_sp      = resultSp.initialInteractionsRichness
  val initialSR_egoIR   = resultEgoIR.initialSpeciesRichness
  val initialIR_egoIR   = resultEgoIR.initialInteractionsRichness
  val initialSR_connInt = resultConnInt.initialSpeciesRichness
  val initialIR_connInt = resultConnInt.initialInteractionsRichness

  val finalSR_sp      = finalWorldSp.getSpeciesRichness()
  val finalSR_egoIR   = finalWorldEgoIR.getSpeciesRichness()
  val finalSR_connInt = finalWorldConnInt.getSpeciesRichness()

  val irLost_sp      = resultSp.primaryInteractionsLost      + resultSp.secondaryInteractionsLost
  val irLost_egoIR   = resultEgoIR.primaryInteractionsLost   + resultEgoIR.secondaryInteractionsLost
  val irLost_connInt = resultConnInt.primaryInteractionsLost + resultConnInt.secondaryInteractionsLost

  val speciesExtinctions_species     = if initialSR_sp      > 0 then (initialSR_sp      - finalSR_sp).toDouble      / initialSR_sp      * 100.0 else 0.0
  val speciesExtinctions_egoIR       = if initialSR_egoIR   > 0 then (initialSR_egoIR   - finalSR_egoIR).toDouble   / initialSR_egoIR   * 100.0 else 0.0
  val speciesExtinctions_connInt     = if initialSR_connInt  > 0 then (initialSR_connInt  - finalSR_connInt).toDouble / initialSR_connInt  * 100.0 else 0.0
  val interactionExtinctions_species = if initialIR_sp      > 0 then irLost_sp.toDouble      / initialIR_sp      * 100.0 else 0.0
  val interactionExtinctions_egoIR   = if initialIR_egoIR   > 0 then irLost_egoIR.toDouble   / initialIR_egoIR   * 100.0 else 0.0
  val interactionExtinctions_connInt = if initialIR_connInt  > 0 then irLost_connInt.toDouble / initialIR_connInt  * 100.0 else 0.0

  // ── Cascade counts ────────────────────────────────────────────────────────────
  val nCascades_species  = resultSp.nCascades
  val nCascades_egoIR    = resultEgoIR.nCascades
  val nCascades_connInt  = resultConnInt.nCascades

  // ── Primary extinctions ───────────────────────────────────────────────────────
  val primarySpeciesExtinctions_species         = resultSp.primarySpeciesLost
  val primarySpeciesExtinctions_egoIR           = resultEgoIR.primarySpeciesLost
  val primarySpeciesExtinctions_connInt         = resultConnInt.primarySpeciesLost
  val primaryInteractionExtinctions_species     = resultSp.primaryInteractionsLost
  val primaryInteractionExtinctions_egoIR       = resultEgoIR.primaryInteractionsLost
  val primaryInteractionExtinctions_connInt     = resultConnInt.primaryInteractionsLost

  // ── Secondary extinctions ─────────────────────────────────────────────────────
  val secondarySpeciesExtinctions_species       = resultSp.secondarySpeciesLost
  val secondarySpeciesExtinctions_egoIR         = resultEgoIR.secondarySpeciesLost
  val secondarySpeciesExtinctions_connInt       = resultConnInt.secondarySpeciesLost
  val secondaryInteractionExtinctions_species   = resultSp.secondaryInteractionsLost
  val secondaryInteractionExtinctions_egoIR     = resultEgoIR.secondaryInteractionsLost
  val secondaryInteractionExtinctions_connInt   = resultConnInt.secondaryInteractionsLost
  """
) set (
  inputs  += (fractionProtected, avgPopulationsPerTile, myseed),
  outputs += (
    fractionProtected, avgPopulationsPerTile, myseed, nTiles,
    // Landscape diagnostics
    landscapeAlphaSR, landscapeAlphaSRstd, landscapeBetaSR,
    landscapeAlphaIR, landscapeAlphaIRstd, landscapeBetaIR,
    // Extinction fractions
    speciesExtinctions_species, speciesExtinctions_egoIR, speciesExtinctions_connInt,
    interactionExtinctions_species, interactionExtinctions_egoIR, interactionExtinctions_connInt,
    // Cascade counts
    nCascades_species, nCascades_egoIR, nCascades_connInt,
    // Primary extinctions
    primarySpeciesExtinctions_species, primarySpeciesExtinctions_egoIR, primarySpeciesExtinctions_connInt,
    primaryInteractionExtinctions_species, primaryInteractionExtinctions_egoIR, primaryInteractionExtinctions_connInt,
    // Secondary extinctions
    secondarySpeciesExtinctions_species, secondarySpeciesExtinctions_egoIR, secondarySpeciesExtinctions_connInt,
    secondaryInteractionExtinctions_species, secondaryInteractionExtinctions_egoIR, secondaryInteractionExtinctions_connInt,
    // Beta diversity of protected set (pre-extinction)
    speciesBetaDiversity_pre_species, speciesBetaDiversity_pre_egoIR, speciesBetaDiversity_pre_connInt,
    interactionBetaDiversity_pre_species, interactionBetaDiversity_pre_egoIR, interactionBetaDiversity_pre_connInt
  ),
  plugins += pluginsOf(
    econetcons.World,
    econetcons.ConservationParameters,
    econetcons.WorldParameters,
    econetcons.ConservationStrategy,
    econetcons.DiagnosticMetrics,
    econetcons.SimulationMetrics,
    econetcons.DetailedExtinctions
  )
)

// ─── Environments ─────────────────────────────────────────────────────────────
val atlas = SLURMEnvironment(
  "integratedmodelling",
  "atlas-fdr.sw.ehu.es",
  workDirectory   = "/scratch/integratedmodelling/animalitos",
  sharedDirectory = "/scratch/integratedmodelling/.tmp/",
  modules         = Seq("Apptainer"),
  partition       = "general",
  qos             = "regular",
  nodes           = 3,
  time            = 1 hour,
  submittedJobs   = 72,
)

val local = LocalEnvironment(4)

// ─── Experiment ───────────────────────────────────────────────────────────────
val replications = Replication(
  evaluation = altStrategySweepSim,
  seed       = myseed,
  sample     = 100,
)

DirectSampling(
  evaluation = replications,
  sampling   =
    (fractionProtected     in (0.0 to 1.0 by 0.025)) x
    (avgPopulationsPerTile in Seq(2, 5, 10, 20, 40, 80, 160)),
) hook (workDirectory / "tile_size_sweep_alt_strategies") on atlas
